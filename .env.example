# JARVIS - Configuration

# Assistant Identity
JARVIS_NAME=Jarvis

# Local LLM Runtime (Ollama - disabled by default for instant Rock-Solid Desktop Pilot mode)
JARVIS_LLM_ENABLED=false
JARVIS_MODEL=qwen2.5:1.5b
JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_KEEP_ALIVE=15m
JARVIS_THINK_MODE=false
JARVIS_TEMPERATURE=0.7

# Logging
JARVIS_LOG_LEVEL=INFO

# Speech-to-Text (Push-to-Talk STT)
JARVIS_VOICE_ENABLED=false
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
# JARVIS_STT_LANGUAGE=id  # Options: id, en, auto
# JARVIS_AUDIO_DEVICE=20

# Text-to-Speech (TTS)
JARVIS_TTS_ENABLED=true
JARVIS_TTS_MODEL_EN=en_GB-alan-low
JARVIS_TTS_MODEL_ID=id_ID-news_tts-medium
JARVIS_TTS_LANGUAGE_MODE=auto
JARVIS_TTS_RATE=1.0

# Wake Word (Phase 4 Always-Listening)
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_WAKE_WORD_MODEL=hey_jarvis_v0.1.onnx
JARVIS_WAKE_WORD_ALIASES=jarvis,jarpis
JARVIS_WAKE_WORD_THRESHOLD=0.15
JARVIS_WAKE_WORD_COOLDOWN=1.5
JARVIS_WAKE_WORD_VAD_THRESHOLD=0.0
JARVIS_WAKE_WORD_SPEECH_START_GRACE=3.0
JARVIS_WAKE_WORD_POST_SPEECH_SILENCE=1.8
JARVIS_WAKE_WORD_SILENCE_TIMEOUT=1.2
JARVIS_WAKE_WORD_MAX_COMMAND_DURATION=8.0

# Web Search & Intelligence
JARVIS_WEB_SEARCH_ENABLED=true
JARVIS_SEARCH_PROVIDER=google
JARVIS_MEMORY_ENABLED=false

# Context Interpreter & Cloud Reasoning
JARVIS_INTERPRETER_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
